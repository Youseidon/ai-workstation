{
  "name": "ai-orchestration",
  "version": "0.1.0",
  "private": true,
  "description": "Web-based multi-agent live console for local CLI coding agents",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace shared && npm run build --workspace server && npm run build --workspace web",
    "start": "concurrently --kill-others-on-fail -n server,web -c cyan,magenta \"npm:start:server\" \"npm:start:web\"",
    "start:server": "npm run start --workspace server",
    "start:web": "npm run start --workspace web",
    "typecheck": "npm run typecheck --workspace shared && npm run typecheck --workspace server && npm run typecheck --workspace web",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:m4-browser": "npm run verify:m4-browser --workspace web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
