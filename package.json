{
  "name": "ai-orchestration",
  "version": "0.1.0",
  "private": true,
  "description": "Web-based multi-agent live console for local CLI coding agents",
  "workspaces": [
    "shared",
    "server",
    "web",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:team-pilot": "node scripts/run-team-pilot.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "node scripts/dev-web.mjs",
    "dev:sandbox": "node scripts/dev-sandbox.mjs",
    "free-ports": "node scripts/free-ports.mjs",
    "serve": "npm run build && npm run free-ports && concurrently --kill-others-on-fail -n server,web -c cyan,magenta \"npm:serve:server\" \"npm:serve:web\"",
    "serve:server": "npm run serve --workspace server",
    "serve:web": "npm run start --workspace web",
    "setup:team-pilot": "node scripts/setup-team-pilot.mjs",
    "test:team-pilot-setup": "node --test scripts/setup-team-pilot.test.mjs",
    "build": "npm run build --workspace shared && npm run build --workspace server && npm run build --workspace web",
    "start": "concurrently --kill-others-on-fail -n server,web -c cyan,magenta \"npm:start:server\" \"npm:start:web\"",
    "start:server": "npm run start --workspace server",
    "start:web": "npm run start --workspace web",
    "typecheck": "npm run typecheck --workspace shared && npm run typecheck --workspace server && npm run typecheck --workspace web && npm run typecheck --workspace e2e",
    "test": "npm run test --workspace shared && npm run test --workspace server && npm run test --workspace web",
    "test:harness": "npm run test --workspace e2e",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:m4-browser": "npm run verify:m4-browser --workspace web",
    "sync:cursor-models": "node scripts/sync-cursor-models.mjs",
    "e2e": "npm run e2e --workspace e2e",
    "e2e:visual": "npm run e2e:visual --workspace e2e",
    "e2e:live": "npm run e2e:live --workspace e2e",
    "e2e:burn-in": "npm run e2e:burn-in --workspace e2e"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
