# ─────────────────────────────────────────────────────────────────────────────
# Multi-Agent Live Console — copy to `.env` and edit.
# The server reads this file from the repo root. Never commit your real .env:
# every value here is server-side only and is never sent to the browser.
#
# Everything below the "Server" block is also editable at runtime from the
# Agents page; those overrides are saved to .agent-console/settings.json and
# take precedence over this file. HOST, PORT and ALLOWED_ORIGINS are boot-time
# only and can only be set here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=4000

# How often the server pushes an elapsed-time/token status heartbeat (ms).
STATUS_INTERVAL_MS=1000

# When true, every provider can reach Docker and other host services:
# Codex runs as danger-full-access, Claude/Grok skip permission prompts,
# Grok's OS sandbox is turned off, and Copilot runs yolo. Required for
# docker compose / docker.sock.
# The per-provider sandbox knobs below are ignored while this is on. Dangerous.
AGENT_HOST_ACCESS=false

# Browser origins allowed to open the WebSocket. Comma separated.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set DEBUG=1 to log child-process stderr and unparsed stdout lines.
# DEBUG=1

# ── Claude Code (@anthropic-ai/claude-agent-sdk, in-process) ─────────────────
# Optional if you have already logged in with the `claude` CLI: the SDK reuses
# ~/.claude/.credentials.json. Set the key to use API billing instead.
ANTHROPIC_API_KEY=

# Default model, used when nothing is picked in the header's model dropdown.
# Leave blank to use the SDK default model.
CLAUDE_MODEL=

# default | acceptEdits | bypassPermissions | plan | dontAsk
#   default          — prompts for dangerous ops; in headless mode those are denied
#   acceptEdits      — auto-accepts file edits inside the workdir  (default here)
#   plan             — read-only planning, no tool execution
#   dontAsk          — never prompt; deny anything not pre-approved
#   bypassPermissions— no permission checks at all. Dangerous.
CLAUDE_PERMISSION_MODE=acceptEdits

# Which Claude Code settings files to honour (CLAUDE.md, settings.json, ...).
CLAUDE_SETTING_SOURCES=user,project,local

# Stop the run after N assistant turns. 0 = no limit.
CLAUDE_MAX_TURNS=0

# ── Codex CLI (spawned: `codex exec --json`) ─────────────────────────────────
# Optional if you have run `codex login` (credentials live in ~/.codex).
OPENAI_API_KEY=

CODEX_BIN=codex
# Default model; the header's model dropdown overrides it per run.
CODEX_MODEL=

# read-only | workspace-write | danger-full-access
#   read-only         — the agent may read but not write or run network commands
#   workspace-write   — writes confined to the selected workspace   (default here)
#   danger-full-access— no sandbox at all. Dangerous.
CODEX_SANDBOX_MODE=workspace-write

# Codex refuses to run outside a git repo unless this is on.
CODEX_SKIP_GIT_REPO_CHECK=true

# Extra argv appended to `codex exec`, e.g. CODEX_EXTRA_ARGS="-c model_reasoning_effort=high"
CODEX_EXTRA_ARGS=

# ── Cursor CLI (spawned: `cursor-agent -p --output-format ...`) ──────────────
# Auth comes from `cursor-agent login`; CURSOR_API_KEY also works.
CURSOR_BIN=cursor-agent
# Default model; the header's model dropdown overrides it per run.
CURSOR_MODEL=

# stream-json gives live events; json gives one final object.
CURSOR_OUTPUT_FORMAT=stream-json

# Adds --force so the agent never blocks waiting for interactive approval.
# Cursor has no sandbox mode: with force on, it can edit files in the workspace.
CURSOR_FORCE=true

# Set true if login detection misfires but you know you are logged in.
CURSOR_ASSUME_AUTHENTICATED=false

CURSOR_EXTRA_ARGS=

# ── Grok CLI (spawned: `grok -p --output-format streaming-json`) ──────────────
# Optional if you have run `grok login` (credentials live in ~/.grok/auth.json).
XAI_API_KEY=

GROK_BIN=grok
# Default model; the header's model dropdown overrides it per run.
GROK_MODEL=

# default | acceptEdits | auto | dontAsk | bypassPermissions | plan
#   acceptEdits      — auto-accepts file edits inside the workdir  (default here)
#   auto             — safety-checked auto; blocked calls fail headless
#   plan             — read-only planning, no tool execution
#   dontAsk          — never prompt; deny anything not pre-approved
#   default          — prompts for approval; in headless mode those stall
#   bypassPermissions— no permission checks at all. Dangerous.
GROK_PERMISSION_MODE=acceptEdits

# workspace | read-only | strict | off
#   workspace  — writes confined to the selected workspace           (default here)
#   read-only  — may read, but not write project files
#   strict     — read CWD + system paths; writes confined to CWD
#   off        — no sandbox at all. Dangerous.
GROK_SANDBOX_MODE=workspace

# Stop the run after N agentic turns. 0 = no limit.
GROK_MAX_TURNS=0

# Set true if login detection misfires but you know you are logged in.
GROK_ASSUME_AUTHENTICATED=false

GROK_EXTRA_ARGS=

# ── GitHub Copilot CLI (spawned: `copilot -p --output-format json`) ───────────
# Optional if you have run `copilot login`, or if GH_TOKEN / `gh auth login`
# already has a Copilot-enabled GitHub token. Classic ghp_ tokens are rejected
# by Copilot; use a Copilot/gh OAuth token or a fine-grained PAT.
COPILOT_GITHUB_TOKEN=

COPILOT_BIN=copilot
# Default model; the header's model dropdown overrides it per run. Copilot only
# accepts ids your plan's model picker exposes — `auto` always works.
COPILOT_MODEL=

# allow-all-tools | plan | allow-all-paths | yolo
# A headless run has nowhere to show an approval prompt, so tool approval is
# always pre-granted; this chooses how far outside the workspace that reaches.
#   allow-all-tools  — file access stays inside the workspace       (default here)
#   plan             — read-only planning; built-in file writes denied
#   allow-all-paths  — drops path verification; reads/writes anywhere. Dangerous.
#   yolo             — all tools, all paths, all URLs. Dangerous.
COPILOT_PERMISSION_MODE=allow-all-tools

# none | minimal | low | medium | high | xhigh | max. Empty = model default.
COPILOT_REASONING_EFFORT=

# Stop the run after N AI credits. 0 = no cap.
COPILOT_MAX_AI_CREDITS=0

# Copilot's bundled github-mcp-server (issues, pull requests). Off starts faster.
COPILOT_BUILTIN_MCP=true

# Publish sessions to GitHub web/mobile and accept remote control from there.
COPILOT_REMOTE_EXPORT=false

# Set true if `copilot login` stored its token in the OS credential store,
# which the server cannot read.
COPILOT_ASSUME_AUTHENTICATED=false

COPILOT_EXTRA_ARGS=

# ── Frontend ─────────────────────────────────────────────────────────────────
# Where the browser connects. Must be reachable from the browser, not the server.
NEXT_PUBLIC_AGENT_SERVER_URL=http://127.0.0.1:4000
