{
  "name": "@agent-console/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:quota-ui": "node --import tsx --test components/CountUp.test.tsx components/agents/usage.test.tsx components/agents/badge.test.tsx components/recovery.test.tsx",
    "verify:m4-browser": "node --import tsx ../scripts/verify-m4-browser.mjs",
    "verify:handover-browser": "node --import tsx ../scripts/verify-handover-browser.mjs --playwright @playwright/test",
    "test:handover-ui": "node --import tsx --test components/tasks/handoverControl.test.tsx",
    "typecheck": "tsc --noEmit",
    "test:web-ui": "node --import tsx --test $(find components -name '*.test.tsx' | sort)",
    "test": "node --import tsx --test $(find test components \\( -name '*.test.ts' -o -name '*.test.tsx' \\) | sort)"
  },
  "dependencies": {
    "@agent-console/shared": "*",
    "dotenv": "^16.6.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
