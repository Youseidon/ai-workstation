{
  "name": "@hydra/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "HYDRA_MODE=serve tsx src/index.ts",
    "serve": "HYDRA_MODE=serve tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "HYDRA_DB=\"${TMPDIR:-/tmp}/hydra-test-$$.sqlite\" SETTINGS_FILE=\"${TMPDIR:-/tmp}/hydra-test-settings-$$.json\" node --import tsx --test --test-concurrency=1 $(find test -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "@hydra/shared": "*",
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0",
    "shell-quote": "^1.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
